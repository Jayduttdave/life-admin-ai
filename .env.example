# Life Admin AI - Environment Configuration Template
# Copy this file to .env.local for local development

# n8n Webhook URL
# Expects a POST request with multipart/form-data containing binary field 'data0'
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/your-webhook-id

# For production deployments:
# N8N_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/your-production-webhook-id
